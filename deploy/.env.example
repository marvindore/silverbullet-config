# Copy to .env (compose) or paste into Portainer stack variables.
CONFIG_REPO_URL=https://github.com/marvindore/silverbullet-config.git
SPACE_PATH=/srv/silverbullet/space
BIND=0.0.0.0:3000
# Syntax: set SB_USER to youruser:yourpassword (one variable, colon-separated).
SB_USER=
# Work only:
# CA_BUNDLE=/Users/you/docker/silverbullet/ca-certificates.pem
